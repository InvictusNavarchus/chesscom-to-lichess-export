{
	"$schema": "node_modules/release-it/schema/release-it.json",
	"plugins": {
		"@release-it/bumper": {
			"out": {
				"file": "vite.config.ts",
				"type": "text/plain",
				"search": "version: '[0-9]+\\.[0-9]+\\.[0-9]+'",
				"replace": "version: '${version}'"
			}
		}
	},
	"git": {
		"commitMessage": "chore(release): bump version to v${version}",
		"tagAnnotation": "Release v${version}",
		"tagName": "v${version}"
	},
	"hooks": {
		"before:github:release": "bun run build"
	},
	"github": {
		"release": true,
		"assets": ["dist/*.js"],
		"releaseName": "v${version}"
	},
	"npm": {
		"publish": false
	}
}
